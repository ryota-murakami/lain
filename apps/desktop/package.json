{
  "name": "lain",
  "private": true,
  "version": "0.1.1",
  "description": "Raindrop.io desktop client for macOS and Linux",
  "author": {
    "name": "Laststance.io",
    "url": "https://laststance.io"
  },
  "homepage": "https://github.com/ryota-murakami/lain",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryota-murakami/lain.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "pnpm build && playwright test --ui",
    "codegen:api": "tsx scripts/codegen-api.ts",
    "knip": "knip",
    "coverage:e2e-spec": "tsx scripts/e2e-coverage-report.ts",
    "electron:build": "pnpm build && electron-builder --mac",
    "electron:build:dir": "pnpm build && electron-builder --mac --dir",
    "electron:finalize:mac": "tsx scripts/finalize-mac-release-artifacts.ts",
    "electron:release:mac": "rm -rf release && pnpm build && electron-builder --mac --arm64 --x64 --publish never && pnpm electron:finalize:mac"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@laststance/redux-storage-middleware": "^0.5.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-redux": "^9.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "ts-pattern": "^5.9.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@laststance/react-next-eslint-plugin": "^2.4.0",
    "@playwright/test": "^1.65.0",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-ts-prefixer": "^5.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.2",
    "msw": "^3.0.4",
    "shadcn": "^4.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.1.0"
  }
}
