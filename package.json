{
  "name": "lain-monorepo",
  "private": true,
  "description": "Lain monorepo: macOS desktop client and landing page",
  "author": {
    "name": "Laststance.io",
    "url": "https://laststance.io"
  },
  "homepage": "https://github.com/laststance/lain",
  "repository": {
    "type": "git",
    "url": "https://github.com/laststance/lain.git"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter lain dev",
    "build": "pnpm --filter lain build",
    "lint": "pnpm --filter lain lint",
    "typecheck": "pnpm --filter lain typecheck",
    "preview": "pnpm --filter lain preview",
    "test": "pnpm --filter lain test",
    "test:watch": "pnpm --filter lain test:watch",
    "test:coverage": "pnpm --filter lain test:coverage",
    "test:e2e": "pnpm --filter lain test:e2e",
    "test:e2e:ui": "pnpm --filter lain test:e2e:ui",
    "codegen:api": "pnpm --filter lain codegen:api",
    "knip": "pnpm --filter lain knip",
    "coverage:e2e-spec": "pnpm --filter lain --silent coverage:e2e-spec",
    "electron:build": "pnpm --filter lain electron:build",
    "electron:build:dir": "pnpm --filter lain electron:build:dir",
    "electron:finalize:mac": "pnpm --filter lain electron:finalize:mac",
    "electron:release:mac": "pnpm --filter lain electron:release:mac",
    "dev:web": "pnpm --filter lain-web dev",
    "build:web": "pnpm --filter lain-web build",
    "start:web": "pnpm --filter lain-web start",
    "lint:web": "pnpm --filter lain-web lint",
    "typecheck:web": "pnpm --filter lain-web typecheck",
    "validate:web": "pnpm lint:web && pnpm typecheck:web && pnpm build:web",
    "prettier": "prettier --ignore-unknown --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  }
}
